{
  "name": "figure-gallery-val02b-browser-harness",
  "version": "0.0.0",
  "private": true,
  "description": "Disposable, loopback-only Playwright gates for the VAL-02B Wagtail and Payload spikes",
  "type": "module",
  "scripts": {
    "probe:chrome": "node scripts/probe-browser.mjs",
    "summarize:browser": "node scripts/summarize-browser-results.mjs",
    "test:browser": "playwright test",
    "test:browser:wagtail": "playwright test --project=wagtail-chrome",
    "test:browser:payload": "playwright test --project=payload-chrome",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
