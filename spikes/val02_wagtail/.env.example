# Disposable local prototype only. Generate fresh values per run; never commit .env.
DJANGO_SECRET_KEY=replace-with-a-local-random-value
VAL02_WAGTAIL_CANDIDATE_TOKEN=replace-with-a-local-random-value
DJANGO_DEBUG=true
VAL02_BLOCK_HPOI=true
VAL02_WAGTAIL_RUNTIME_DIR=

# Optional S3-compatible storage boundary. It is disabled by default and was not
# connected to a cloud service during VAL-02.
USE_S3_STORAGE=false
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
