# Generate a fresh local value at runtime. Never commit the real value.
PAYLOAD_SECRET=
DATABASE_ADAPTER=sqlite
DATABASE_URI=file:./val02-payload.db
# Fail closed by default. Set true only while running `payload migrate:create`
# against a disposable PostgreSQL database; never enable for migrate/start.
PAYLOAD_ALLOW_EMPTY_POSTGRES_MIGRATIONS_FOR_GENERATION=false
MEDIA_DIR=./media
HOSTNAME=127.0.0.1
PORT=3000

# Runtime-only token used by provision:client and the shared Python client.
VAL02_PAYLOAD_CANDIDATE_TOKEN=
VAL02_PAYLOAD_CANDIDATE_CLIENT_ID=
VAL02_PAYLOAD_CANDIDATE_ENDPOINT=http://127.0.0.1:3000/api/candidate-records/upsert
VAL02_PAYLOAD_CANDIDATE_UPLOAD_ENDPOINT=http://127.0.0.1:3000/api/val02b/candidate-media/upload

# Runtime-only browser fixture administrator. Never commit real values.
VAL02_PAYLOAD_ADMIN_EMAIL=
VAL02_PAYLOAD_ADMIN_PASSWORD=

# Optional official @payloadcms/storage-s3 boundary. Disabled by default.
S3_ENABLED=false
S3_BUCKET=
S3_REGION=
S3_PREFIX=figure-gallery/val02-payload
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
