# Generate a fresh local value at runtime. Never commit the real value.
PAYLOAD_SECRET=
DATABASE_URI=file:./val02-payload.db
MEDIA_DIR=./media

# Runtime-only token used by provision:client and the shared Python client.
VAL02_PAYLOAD_CANDIDATE_TOKEN=
VAL02_PAYLOAD_CANDIDATE_ENDPOINT=http://127.0.0.1:3000/api/candidate-records/upsert

# Optional official @payloadcms/storage-s3 boundary. Disabled by default.
S3_ENABLED=false
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
