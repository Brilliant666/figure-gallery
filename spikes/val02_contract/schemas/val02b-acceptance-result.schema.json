{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://figure-gallery.invalid/schemas/val02b-acceptance-result-v1.json",
  "title": "VAL-02B prototype-generated gate result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "prototype", "generated_at", "generated_by", "fixture_sha256", "assertions"],
  "properties": {
    "schema_version": {"const": 1},
    "contract_id": {"const": "val02b-acceptance-v1"},
    "prototype": {"enum": ["wagtail", "payload"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "command", "source_digest", "source_files"],
      "properties": {
        "runner": {"type": "string", "minLength": 1, "not": {"pattern": "(?i)^manual$"}},
        "command": {"type": "string", "minLength": 1},
        "source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "fixture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime": {"type": "object"},
    "environment": {"type": "object"},
    "metrics": {"type": "object"},
    "exports": {"type": "object"},
    "security": {"type": "object"},
    "assertions": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^BG-(0[1-9]|[12][0-9]|30)$"},
          "status": {"enum": ["pass", "fail", "not_run", "environment_blocked"]},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "reference", "observed"],
              "properties": {
                "kind": {"type": "string", "minLength": 1},
                "reference": {"type": "string", "minLength": 1},
                "observed": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
